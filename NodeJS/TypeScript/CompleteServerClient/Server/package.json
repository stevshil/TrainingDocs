{
  "name": "swapi-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Grabs data from the Star Wars API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "swapi": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "webdev": "tsx src/webfilm.ts",
    "peopledev": "tsx src/webpeople.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "http": "^0.0.1-security",
    "mongodb": "^6.21.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
